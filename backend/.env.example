# Скопируйте в .env и поправьте. Для локальной разработки все переменные необязательны.
ENV=dev
DATABASE_URL=sqlite:///./look.db
MEDIA_DIR=./media
CORS_ORIGINS=["*"]

# Ключ для хэшей кодов входа. В проде обязательно замените: openssl rand -hex 32
SECRET_KEY=dev-only-secret-change-me-before-deploy-0123456789

# Только для разработки: вернуть код входа в ответе API (в проде запрещено).
DEV_RETURN_CODE=true
